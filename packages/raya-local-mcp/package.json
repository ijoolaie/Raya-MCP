{
    "name":  "@ijoolaie/local-mcp",
    "version":  "0.1.0",
    "description":  "Local workspace and machine capabilities implemented on Raya MCP Core.",
    "type":  "module",
    "exports":  {
                    ".":  "./src/server.mjs",
                    "./advanced-tools":  "./src/advanced-tools.mjs",
                    "./format-tools":  "./src/format-tools.mjs",
                    "./url-tools":  "./src/url-tools.mjs"
                },
    "files":  [
                  "src",
