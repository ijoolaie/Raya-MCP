                         "mammoth":  "^1.13.0",
                         "pdf-lib":  "^1.17.1",
                         "pdf-parse":  "^2.4.5",
                         "zod":  "4.6.7"
                     },
    "publishConfig":  {
                          "registry":  "https://npm.pkg.github.com"
                      },
    "repository":  {
